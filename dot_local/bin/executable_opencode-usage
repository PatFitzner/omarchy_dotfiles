#!/usr/bin/env python3
"""OpenCode Go subscription usage monitor for Waybar.

Fetches usage data from the OpenCode billing page using browser cookies.
Displays balance, monthly usage percentage, and reset time.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import browser_cookie3
from curl_cffi import requests

# ==================== Configuration ====================

OPENCODE_DOMAIN = "opencode.ai"
FIREFOX_COOKIE_FILE = Path.home() / ".config/mozilla/firefox/tgahoqgl.default-release/cookies.sqlite"
WORKSPACE_ID = "wrk_01KK4N3ACDFWSNYVQ2KW88PZQ8"
BILLING_URL = f"https://opencode.ai/workspace/{WORKSPACE_ID}/billing"

CACHE_DIR = Path.home() / ".cache" / "waybar-ai-usage"
CACHE_FILE = CACHE_DIR / "opencode-go.json"
CACHE_TTL = 120  # seconds


# ==================== Cookie Loading ====================


def load_cookies() -> dict:
    """Load opencode.ai cookies from Firefox."""
    cj = browser_cookie3.firefox(
        cookie_file=str(FIREFOX_COOKIE_FILE),
        domain_name=OPENCODE_DOMAIN,
    )
    cookies = {c.name: c.value for c in cj}
    if not cookies:
        raise RuntimeError("No cookies found for opencode.ai in Firefox")
    return cookies


# ==================== Data Fetching ====================


def parse_usage_from_html(html: str) -> dict:
    """Parse lite subscription usage data from the billing page HTML."""
    # New format: balance:1500000000,reload:!0,reloadAmount:10,...,monthlyLimit:25,monthlyUsage:0,timeMonthlyUsageUpdated:$R[24]=new Date("2026-03-29T00:57:37.000Z")
    m = re.search(
        r'balance:(\d+),.*?monthlyLimit:(\d+),monthlyUsage:(\d+),timeMonthlyUsageUpdated:\$R\[\d+\]=new Date\("([^"]+)"\)',
        html,
    )
    if not m:
        m = re.search(
            r'balance:(\d+),.*?monthlyLimit:(\d+),monthlyUsage:(\d+)',
            html,
        )
    if not m:
        raise RuntimeError("Could not parse usage data from billing page")

    balance_raw = int(m.group(1))
    monthly_limit = int(m.group(2))
    monthly_usage = int(m.group(3))

    # Balance is in nanodollars (1e-9), convert to dollars
    balance_usd = balance_raw / 100_000_000

    # Monthly usage is in dollars, calculate percentage
    usage_pct = round(monthly_usage / monthly_limit * 100) if monthly_limit > 0 else 0

    # Parse timeMonthlyUsageUpdated if available
    time_updated = None
    if len(m.groups()) >= 4:
        try:
            time_updated = datetime.fromisoformat(m.group(4).replace("Z", "+00:00"))
        except ValueError:
            pass

    # Calculate seconds until monthly reset (1st of next month)
    now = datetime.now(timezone.utc)
    if time_updated:
        # Reset is on the 1st of the next month
        if now.month == 12:
            next_reset = datetime(now.year + 1, 1, 1, tzinfo=timezone.utc)
        else:
            next_reset = datetime(now.year, now.month + 1, 1, tzinfo=timezone.utc)
        reset_in_sec = int((next_reset - now).total_seconds())
    else:
        reset_in_sec = 0

    return {
        "balance_usd": balance_usd,
        "monthly_limit": monthly_limit,
        "monthly_usage": monthly_usage,
        "usage_percent": usage_pct,
        "reset_in_sec": reset_in_sec,
        "time_updated": time_updated.isoformat() if time_updated else None,
    }


def fetch_usage_uncached() -> dict:
    """Fetch usage data from the billing page."""
    cookies = load_cookies()

    resp = requests.get(
        BILLING_URL,
        cookies=cookies,
        headers={
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        },
        impersonate="chrome",
        timeout=15,
        allow_redirects=True,
    )

    if resp.status_code in (401, 403):
        raise RuntimeError("Auth error — log into opencode.ai in Firefox and retry")

    resp.raise_for_status()
    return parse_usage_from_html(resp.text)


def fetch_usage() -> dict:
    """Fetch usage with file-based caching."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    if CACHE_FILE.exists():
        age = time.time() - CACHE_FILE.stat().st_mtime
        if age < CACHE_TTL:
            try:
                return json.loads(CACHE_FILE.read_text())
            except Exception:
                pass

    data = fetch_usage_uncached()
    CACHE_FILE.write_text(json.dumps(data))
    return data


# ==================== Formatting ====================


def format_reset(seconds: int) -> str:
    """Format seconds until reset as human-readable string."""
    if seconds <= 0:
        return "now"
    if seconds >= 86400:
        d = seconds // 86400
        h = (seconds % 86400) // 3600
        return f"{d}d{h:02}h"
    if seconds >= 3600:
        h = seconds // 3600
        m = (seconds % 3600) // 60
        return f"{h}h{m:02}m"
    m = seconds // 60
    s = seconds % 60
    return f"{m}m{s:02}s"


def usage_color(pct: int) -> str:
    """Return color hex for usage percentage."""
    if pct >= 80:
        return "#f38ba8"  # red
    if pct >= 50:
        return "#f9e2af"  # yellow
    return "#a6e3a1"  # green


def usage_class(pct: int) -> str:
    """Return CSS class for usage percentage."""
    if pct >= 80:
        return "oc-high"
    if pct >= 50:
        return "oc-mid"
    return "oc-low"


def print_waybar(data: dict) -> None:
    """Output JSON for Waybar custom module."""
    pct = data.get("usage_percent", 0)
    reset = format_reset(data.get("reset_in_sec", 0))
    balance = data.get("balance_usd", 0)
    monthly_usage = data.get("monthly_usage", 0)
    monthly_limit = data.get("monthly_limit", 0)

    cls = usage_class(pct)
    col = usage_color(pct)

    text = f"<span foreground='{col}'>{pct}%</span>"

    tooltip = (
        f"OpenCode Go Usage\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"Balance:    ${balance:.2f}\n"
        f"Monthly:    ${monthly_usage:.2f} / ${monthly_limit:.2f} ({pct}%)\n"
        f"Resets in:  {reset}\n"
        f"\n"
        f"Click to refresh"
    )

    print(json.dumps({
        "text": text,
        "tooltip": tooltip,
        "class": cls,
        "alt": f"{pct}%",
    }))


def print_cli(data: dict) -> None:
    """Print usage to terminal."""
    pct = data.get("usage_percent", 0)
    reset = format_reset(data.get("reset_in_sec", 0))
    balance = data.get("balance_usd", 0)
    monthly_usage = data.get("monthly_usage", 0)
    monthly_limit = data.get("monthly_limit", 0)

    print(f"  Balance:  ${balance:.2f}")
    print(f"  Monthly:  ${monthly_usage:.2f} / ${monthly_limit:.2f} ({pct}%)")
    print(f"  Resets:   {reset}")


# ==================== Entry Point ====================


def main() -> None:
    parser = argparse.ArgumentParser(description="OpenCode Go usage for Waybar")
    parser.add_argument("--waybar", action="store_true", help="Output JSON for Waybar")
    args = parser.parse_args()

    try:
        data = fetch_usage()
    except Exception as e:
        if args.waybar:
            err = str(e)
            short = "Auth Err" if ("auth" in err.lower() or "403" in err or "401" in err) else "Err"
            print(json.dumps({
                "text": f"<span foreground='#ff5555'>OC {short}</span>",
                "tooltip": f"Error: {err}\n\nMake sure you're logged into opencode.ai in Firefox",
                "class": "critical",
            }))
            sys.exit(0)
        else:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    if args.waybar:
        print_waybar(data)
    else:
        print(f"OpenCode Go Usage:")
        print_cli(data)


if __name__ == "__main__":
    main()
